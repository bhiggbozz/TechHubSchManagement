# ── TechHub API — Docker Compose environment ───────────────────────────
# Copy this file to `.env` and fill in real values.
# ── TechHub API — Docker Compose environment (OPTIONAL) ────────────────
# Copy this file to `.env` only if you want to OVERRIDE a value for this
# deployment. The app already ships with working settings in appsettings.json,
# so NO .env is required.
#
# This file is a template only. It contains placeholders, never real secrets.
# .env is git-ignored and must never be committed.

# Host port the API is exposed on
APP_PORT=8080

# ── Database (remote SQL Server) ────────────────────────────────────────
DB_CONNECTION_STRING="Data Source=SQL8010.site4now.net;Initial Catalog=db_ac4720_techhub;User Id=db_ac4720_techhub_admin;Password=YOUR_PASSWORD;Encrypt=True;MultipleActiveResultSets=True;Connection Timeout=30"
QUESTION_BANK_CONNECTION_STRING="Data Source=SQL8010.site4now.net;Initial Catalog=db_ac4720_techhub;User Id=db_ac4720_techhub_admin;Password=YOUR_PASSWORD;Encrypt=True;MultipleActiveResultSets=True;Connection Timeout=30"

# ── MongoDB (Atlas) ─────────────────────────────────────────────────────
MONGO_CONNECTION_STRING="mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/?retryWrites=true&w=majority&tls=true"
MONGO_DATABASE_NAME=TechHubBoard

# ── RabbitMQ (CloudAMQP) ────────────────────────────────────────────────
RABBITMQ_AMQP_URL="amqps://USER:PASSWORD@host/vhost"
RABBITMQ_BOARD_BATCH_QUEUE=board.batch.queue

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=YourApp
JWT_AUDIENCE=YourAppUsers
JWT_EXPIRATION_HOURS=24

# ── Cloudinary ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email ───────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_PASSWORD=your-smtp-password
EMAIL_HOST=smtp.elasticemail.com
EMAIL_PORT=2525
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=TechHub

# ── App ─────────────────────────────────────────────────────────────────
# ── To override any app setting, add the matching compose env var and its
# value here. Example: to change the DB, set:
#   DB_CONNECTION_STRING="Server=...;Database=...;User Id=...;Password=...;"
# and in docker-compose.yml add:
#   ConnectionStrings__DbConnectionString: ${DB_CONNECTION_STRING}
#
# ── Recommended overrides for production ───────────────────────────────
APP_BASE_URL=http://localhost:8080
CORS_ORIGIN_0=https://yourfrontend.com

# ── AI / Question Bank ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-2

# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=documents
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
