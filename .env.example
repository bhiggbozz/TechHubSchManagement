# ── TechHub API — Docker Compose environment (OPTIONAL) ────────────────
# Copy this file to `.env` only if you want to OVERRIDE a value for this
# deployment. The app already ships with working settings in appsettings.json,
# so NO .env is required.
#
# This file is a template only. It contains placeholders, never real secrets.
# .env is git-ignored and must never be committed.

# Host port the API is exposed on
APP_PORT=8080

# ── To override any app setting, add the matching compose env var and its
# value here. Example: to change the DB, set:
#   DB_CONNECTION_STRING="Server=...;Database=...;User Id=...;Password=...;"
# and in docker-compose.yml add:
#   ConnectionStrings__DbConnectionString: ${DB_CONNECTION_STRING}
#
# ── Recommended overrides for production ───────────────────────────────
APP_BASE_URL=http://localhost:8080
CORS_ORIGIN_0=https://yourfrontend.com
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
