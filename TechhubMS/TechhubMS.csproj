<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="..\TechHub.Core\**" />
    <Compile Remove="..\TechHub.Service\**" />
    <Compile Remove="..\TechHub.Background\**" />
    <Compile Remove="..\TechHub.Entity.Migration\**" />
    <Compile Remove="..\TeachHub.QuestionBank\**" />
    <EmbeddedResource Remove="..\TechHub.Core\**" />
    <EmbeddedResource Remove="..\TechHub.Service\**" />
    <EmbeddedResource Remove="..\TechHub.Background\**" />
    <EmbeddedResource Remove="..\TechHub.Entity.Migration\**" />
    <EmbeddedResource Remove="..\TeachHub.QuestionBank\**" />
    <None Remove="..\TechHub.Core\**" />
    <None Remove="..\TechHub.Service\**" />
    <None Remove="..\TechHub.Background\**" />
    <None Remove="..\TechHub.Entity.Migration\**" />
    <None Remove="..\TeachHub.QuestionBank\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"
        Version="8.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common"
        Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
        Version="8.0.25">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"
        Version="8.0.25" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Settings.Configuration"
        Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
        Include="..\TeachHub.QuestionBank\TechHub.QuestionBank.csproj" />
    <ProjectReference
        Include="..\TechHub.Background\TechHub.Background.csproj" />
    <ProjectReference
        Include="..\TechHub.Core\TechHub.Core.csproj" />
    <ProjectReference
        Include="..\TechHub.Entity.Migration\TechHub.Entity.Migration.csproj" />
    <ProjectReference
        Include="..\TechHub.Service\TechHub.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
</Project>