{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VirtualBoard": {
    "MaxConnectionsPerServer": 10000,
    "MaxMessagesPerSecond": 1000,
    "HistoryRetentionHours": 24,
    "CleanupIntervalMinutes": 5,
    "MetricsIntervalSeconds": 30
  }
}
